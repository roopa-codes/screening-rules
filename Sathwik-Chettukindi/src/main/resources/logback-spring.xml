<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- One JSON object per line. MDC keys (requestId, ...) are added as top-level fields. -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            <timeZone>UTC</timeZone>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <logger>logger</logger>
                <thread>thread</thread>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>jobId</includeMdcKeyName>
            <includeMdcKeyName>ruleId</includeMdcKeyName>
            <includeMdcKeyName>eventId</includeMdcKeyName>
            <includeContext>false</includeContext>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <!--
      These loggers can print Authorization headers, tokens, request bodies or SQL bind
      values (personal data) at DEBUG/TRACE. They are pinned here so a global DEBUG level
      cannot turn them on.
    -->
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.web.filter.CommonsRequestLoggingFilter" level="OFF"/>
    <logger name="org.apache.coyote.http11" level="INFO"/>
    <logger name="org.apache.http.wire" level="OFF"/>
    <logger name="software.amazon.awssdk.request" level="INFO"/>
    <logger name="software.amazon.awssdk.thirdparty.org.apache.http.wire" level="OFF"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="OFF"/>
    <logger name="org.hibernate.type.descriptor.sql" level="OFF"/>

    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>
</configuration>
